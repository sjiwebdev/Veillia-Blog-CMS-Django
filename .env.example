# Copier vers .env puis adapter :  cp .env.example .env
# Tout est optionnel en développement : SQLite est utilisé par défaut.

# Sécurité 
# Générer une vraie clé : python -c "from django.core.management.utils \
#   import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me

# Hébergement 
DEBUG=True
# Liste séparée par des virgules
ALLOWED_HOSTS=localhost,127.0.0.1
# Ex. : https://veillia.example,https://www.veillia.example
CSRF_TRUSTED_ORIGINS=

# Base de données
# DB_ENGINE=sqlite (défaut) ou postgres
DB_ENGINE=sqlite
DB_NAME=veillia
DB_USER=veillia
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Identité du site
VEILLIA_NAME=VEILLIA
VEILLIA_TAGLINE=Veille intelligente Data Science & Intelligence Artificielle
VEILLIA_CONTACT_EMAIL=contact@veillia.example
DEFAULT_FROM_EMAIL=VEILLIA <no-reply@veillia.example>

# Blog
BLOG_POSTS_PER_PAGE=9
BLOG_NEWSLETTER_ENABLED=True

# Veille multi-sources
AGGREGATOR_ITEMS_PER_PAGE=18
# User-Agent envoyé pendant la collecte (identité + contact : courtoisie)
AGGREGATOR_USER_AGENT=VeilliaBot/1.0 (+mailto:contact@veillia.example)
AGGREGATOR_TIMEOUT_SECONDS=20

# API REST 
API_THROTTLE_ANON=60/minute
API_THROTTLE_USER=240/minute

# Production (DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Journalisation
LOG_LEVEL=INFO
